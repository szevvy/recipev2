# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# bcrypt hash of the shared household password.
# Generate with: npm run gen-password-hash
APP_PASSWORD_HASH=

# Random 32+ byte secret for signing the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=
